{
  "name": "@thienvu18/designable-formily-antd",
  "version": "2.0.2",
  "homepage": "https://github.com/thienvu18/designable#readme",
  "bugs": {
    "url": "https://github.com/thienvu18/designable/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thienvu18/designable.git"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "types": "esm/index.d.ts",
  "files": [
    "lib",
    "esm",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "rimraf -rf lib esm && npm run build:cjs && npm run build:esm && ts-node copy",
    "build:cjs": "tsc --project tsconfig.build.json --outDir lib",
    "build:esm": "tsc --project tsconfig.build.json --module es2020 --outDir esm",
    "build:playground": "webpack --config playground/webpack.prod.ts",
    "start": "webpack-dev-server --config playground/webpack.dev.ts"
  },
  "dependencies": {
    "@thienvu18/designable-core": "2.0.2",
    "@thienvu18/designable-formily-setters": "2.0.2",
    "@thienvu18/designable-formily-transformer": "2.0.2",
    "@thienvu18/designable-react": "2.0.2",
    "classnames": "^2.3.2"
  },
  "devDependencies": {
    "@formily/core": "^2.3.7",
    "@formily/json-schema": "^2.3.7",
    "@formily/path": "^2.3.7",
    "@formily/react": "^2.3.7",
    "@formily/reactive": "^2.3.7",
    "@formily/reactive-react": "^2.3.7",
    "@formily/shared": "^2.3.7",
    "@thienvu18/formily-antd-v6": "^2.0.0",
    "antd": "^6.6.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "typescript": "5.2.2"
  },
  "peerDependencies": {
    "@formily/core": ">=2.3.7 <3",
    "@formily/react": ">=2.3.7 <3",
    "@formily/reactive": ">=2.3.7 <3",
    "@formily/shared": ">=2.3.7 <3",
    "@thienvu18/formily-antd-v6": ">=2 <3",
    "antd": ">=6 <7",
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "publishConfig": {
    "access": "public"
  }
}
