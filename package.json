{
  "name": "root",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thienvu18/designable.git"
  },
  "workspaces": [
    "packages/*",
    "formily/antd",
    "formily/setters",
    "formily/transformer",
    "examples/*"
  ],
  "scripts": {
    "audit:deprecated": "node scripts/audit-deprecated-apis.cjs",
    "audit:emitted": "node scripts/audit-deprecated-apis.cjs --emitted",
    "build": "lerna run build",
    "build:docs": "dumi build",
    "build:examples": "yarn workspaces foreach --all --include '@thienvu18/designable-*-example' --topological-dev run build",
    "build:playground": "yarn workspace @thienvu18/designable-formily-antd build:playground",
    "format": "prettier --write .",
    "lint": "eslint packages formily/antd formily/setters formily/transformer examples scripts/audit-deprecated-apis.cjs scripts/verify-pack.cjs scripts/setupTests.ts tests playwright.config.cjs --ext .js,.cjs,.jsx,.ts,.tsx",
    "lint:fix": "eslint packages formily/antd formily/setters formily/transformer examples scripts/audit-deprecated-apis.cjs scripts/verify-pack.cjs scripts/setupTests.ts tests playwright.config.cjs --ext .js,.cjs,.jsx,.ts,.tsx --fix",
    "release": "lerna publish from-package --yes",
    "test": "jest --coverage",
    "test:prod": "jest --coverage --silent",
    "test:visual": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify": "yarn audit:deprecated && yarn lint && yarn typecheck && yarn build && yarn audit:emitted && yarn build:docs && yarn build:examples && yarn build:playground && CI=true yarn test:prod --runInBand && yarn test:visual && yarn verify:pack",
    "verify:pack": "node scripts/verify-pack.cjs",
    "version:alpha": "lerna version prerelease --preid alpha",
    "version:beta": "lerna version prerelease --preid beta",
    "version:major": "lerna version major",
    "version:minor": "lerna version minor",
    "version:patch": "lerna version patch",
    "version:rc": "lerna version prerelease --preid rc"
  },
  "resolutions": {
    "less-loader@npm:11.1.0": "npm:12.2.0",
    "postcss@npm:8.5.26": "npm:8.4.31",
    "postcss@npm:^8.4.21": "npm:8.4.31"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@babel/core": "^7.24.0",
    "@formily/core": "^2.3.7",
    "@formily/json-schema": "^2.3.7",
    "@formily/path": "^2.3.7",
    "@formily/react": "^2.3.7",
    "@formily/reactive": "^2.3.7",
    "@formily/reactive-react": "^2.3.7",
    "@formily/shared": "^2.3.7",
    "@formily/validator": "^2.3.7",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.1",
    "@thienvu18/formily-antd-v6": "^2.0.0",
    "@types/fs-extra": "^9.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "antd": "^6.6.3",
    "autoprefixer": "^10.4.20",
    "classnames": "^2.3.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "dumi": "^2.4.49",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-markdown": "^3.0.1",
    "eslint-plugin-react": "^7.37.5",
    "fs-extra": "^10.1.0",
    "glob": "^8.0.3",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lerna": "^8.2.4",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "mini-css-extract-plugin": "^2.8.1",
    "monaco-editor": "^0.47.0",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "postcss": "^8.4.31",
    "prettier": "^2.8.8",
    "pretty-format": "^29.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "rimraf": "^3.0.0",
    "style-loader": "^3.3.4",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "5.2.2",
    "webpack": "^5.99.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "packageManager": "yarn@4.6.0",
  "engines": {
    "node": ">=20 <25"
  }
}
